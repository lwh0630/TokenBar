<?xml version="1.0" encoding="utf-8"?>
<!-- Dark "liquid glass" card: a deep indigo gradient with a lit hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#F0231F45"
                android:startColor="#F0141A2E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
